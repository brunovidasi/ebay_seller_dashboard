# Copy this file to .env and fill in real values. Never commit .env.

# "sandbox" or "production"
EBAY_ENV=sandbox

# From your eBay Developer Program keyset
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DEV_ID=

# The "RuName" (eBay Redirect URL name) configured under
# Developer Program > Application Keys > User Tokens > "Get a Token from eBay via Your Application".
# Its accepted redirect URL must be https://localhost:4000/api/ebay/auth/callback — eBay forces
# https here, which is why the backend serves TLS locally (see scripts/gen-cert.sh).
EBAY_RU_NAME=

# OAuth scopes requested from the seller during consent (space-separated)
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account

# Target marketplace/currency — see https://developer.ebay.com/api-docs/static/rest-request-components.html#marketplc
EBAY_MARKETPLACE_ID=EBAY_AU
EBAY_CURRENCY=AUD
EBAY_CONTENT_LANGUAGE=en-AU

PORT=4000
FRONTEND_URL=http://localhost:5173

# Where OAuth tokens are cached on disk until a real database is introduced
TOKEN_STORE_PATH=.data/ebay-tokens.json

# Self-signed dev TLS cert, auto-generated by scripts/gen-cert.sh — no need to change these
TLS_KEY_PATH=certs/localhost-key.pem
TLS_CERT_PATH=certs/localhost-cert.pem
